# ========================================
# Production Environment Configuration
# ========================================

# Node Environment
NODE_ENV=production

# ========================================
# Server Configuration
# ========================================

# API Server Port
API_PORT=3000

# API Server Host
API_HOST=0.0.0.0

# ========================================
# Database Configuration
# ========================================

# SQLite Database Path
DB_PATH=/app/data/scheduler.db

# ========================================
# LLM API Configuration
# ========================================

# Your LLM API Key
# Get it from: https://console.anthropic.com
LLM_API_KEY=your-api-key-here

# ========================================
# Logging Configuration
# ========================================

# Log Level: debug, info, warn, error
LOG_LEVEL=info

# Log Format: json, text
LOG_FORMAT=json

# ========================================
# Security Configuration
# ========================================

# Allowed Origins (CORS)
# Multiple origins separated by comma
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# JWT Secret (if using authentication)
# JWT_SECRET=your-secret-key-here

# ========================================
# Feature Flags
# ========================================

# Enable Markdown Rendering
ENABLE_MARKDOWN=true

# Enable Conversation Analysis
ENABLE_ANALYSIS=true

# Enable Auto Refresh
ENABLE_AUTO_REFRESH=true

# ========================================
# Performance Configuration
# ========================================

# Database Connection Pool Size
DB_POOL_SIZE=10

# Request Timeout (in seconds)
REQUEST_TIMEOUT=30

# ========================================
# Email Configuration (Optional)
# ========================================

# SMTP Server
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# ========================================
# Backup Configuration
# ========================================

# Enable Auto Backup
ENABLE_AUTO_BACKUP=true

# Backup Frequency (in hours)
BACKUP_FREQUENCY=24

# Keep Last N Backups
BACKUP_RETENTION=7

# ========================================
# Monitoring Configuration (Optional)
# ========================================

# Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-url

# DataDog APM
# DD_TRACE_ENABLED=false
# DD_SERVICE_NAME=claude-scheduler

# ========================================
# Docker Configuration
# ========================================

# Docker Log Level
DOCKER_LOG_LEVEL=info

# Container Memory Limit
# CONTAINER_MEMORY=2G

# Container CPU Limit
# CONTAINER_CPUS=2

# ========================================
# Notes
# ========================================
# 1. Copy this file to .env.production
# 2. Update the values according to your environment
# 3. Keep sensitive information (API keys, passwords) secure
# 4. Never commit .env.production to version control
# 5. Use strong API keys and secrets
